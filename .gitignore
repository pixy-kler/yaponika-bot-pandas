# ==========================================
# 1. PYTHON & VIRTUAL ENVIRONMENTS (Критично)
# ==========================================
# Кеш компиляции Python (байт-код)
__pycache__/
*.py[cod]
*$py.class

# Виртуальные окружения (их нельзя коммитить, они весят гигабайты)
venv/
env/
.venv/
env.bak/
venv.bak/

# Файлы установщиков и метаданные пакетов
*.egg-info/
*.egg
.eggs/
pip-log.txt
pip-delete-this-directory.txt

# ==========================================
# 2. JUPYTER NOTEBOOK OUTPUTS
# ==========================================
# Папки с чекпоинтами (автосохранения Jupyter)
.ipynb_checkpoints/
*.ipynb_checkpoints/

# ==========================================
# 3. SENSITIVE DATA & PRIVACY
# ==========================================
# Файлы с данными учеников. Выкладка телефонов и имен в публичный репозиторий 
# нарушает законы о персональных данных (GDPR / ФЗ-152)!
students.csv
students_jp.csv
*.csv
*.xlsx
*.xls
*.xlsm

# Файлы с отчетами, если бот генерирует их автоматически
weekly_report_*.txt
dashboard_*.html

# ==========================================
# 4. SECRETS & TOKENS (Безопасность ботов)
# ==========================================
# Токены от Telegram, MAX (VK Teams), WhatsApp
.env
config.py
*.env
.env.local
BOT_TOKEN

# Файлы с секретами VK / API
vk_teams_token.txt
*_token.py

# ==========================================
# 5. SYSTEM & IDE FILES (Мусор)
# ==========================================
# Файлы операционных систем
.DS_Store
Thumbs.db
desktop.ini

# Файлы редакторов кода (VS Code, PyCharm)
.vscode/
.idea/
*.swp
*.swo
*~

# Логи (если вы используете logging.basicConfig с записью в файл)
*.log
*.log.*

# ==========================================
# 6. ДЛЯ ПРОДУКТОВ (Будущие расширения)
# ==========================================
# Если в будущем вы решите добавить Redis или Docker
redis_data/
*.pid
